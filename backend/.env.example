# App Configuration
APP_NAME="GHOST TV"
PORT=8000
DEBUG=True

# External API Providers
EXTERNAL_CONTENT_API_URL="https://api.example.com/api/films"
EMBED_STREAM_URL="https://embed.example.com/embed.php"
RAW_VIDEO_URL_PREFIX="https://raw.example.com/"
API_TIMEOUT=10.0

# Stream Scraper Cache Settings
STREAM_CACHE_TTL=14400
STREAM_CACHE_MAXSIZE=200

# Security & Database
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"
JWT_SECRET_KEY="your_secret_jwt_key_here"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

